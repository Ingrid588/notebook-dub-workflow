{
  "manifest_version": 3,
  "name": "YouTube Volume Controller",
  "version": "1.0.0",
  "description": "原生立体声 + 软闪避配音混音，不劫持 Web Audio",
  "permissions": ["storage"],
  "host_permissions": ["*://*.youtube.com/*"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["*://*.youtube.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "action": {
    "default_title": "YouTube Volume Controller",
    "default_popup": "popup.html"
  }
}
